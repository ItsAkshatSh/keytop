/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/{
    model = "XIAO keyboard"
    compatible = "seeed, xiao-kb";
    
    zephyr, sram = &sram0;
    zephyr, flash = &flash0;
    zephyr, code-partition = &code_partition;
    zmk, kscan = &kscan;
    zmk, matrix-transform = &default_transform;
    zmk, battery = &fuel_gauge;
};

/*transform matix*/

default_transform: keymap_transform_0 {
    compatible = "zmk, matrix_transform";
    columns = <12>
    rows = <4>
    map = <
    RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)

    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)

    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)

    RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
    >;
};

/*matrix scan*/

kscan0: kscan {
    compatible = "zmk, kscan-gpio-matrix";
    wakeup-source;
    diode-direction = "row2col";

    row-gpios = <&mcp23017 0 GPIO_ACTIVE_HIGH>, <&mcp23017 1 GPIO_ACTIVE_HIGH>, <&mcp23017 2 GPIO_ACTIVE_HIGH>, <&mcp23017 3 GPIO_ACTIVE_HIGH>;

    col-gpios = <&mcp23017 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
    <&mcp23017 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <mcp23017 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, 
    <&mcp23017 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
    <&mcp23017 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&mcp23017 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

/*battery*/

fuel_gauge: fuel_gauge{
    compatible = "zmk, battery-nrf-vddhdiv5";
};