#include <behaviours.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define FN 1
#define BT 2

/{
    tpad_listener:input_listener {
        compatible = "zmk,input-listener";
        device = <&tps65201a>;
    };

    behaviours {
        hm: homerow_mod {
            compatible = "zmk,behaviour-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC

                &kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT

                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp UP &kp ENT

                &kp LCTRL &kp LGUI &kp ALT &kp FN &kp DEL &kp SPACE &kp RGUI &kp FSLH &kp LEFT &kp DOWN &kp RIGHT &none
            >;
        };

        fn_layer {
            <
            &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL

            &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp 57 &kp F8 &kp F9 &kp F10 &kp F11

            &trans &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &trans &trans &kp C_BRI_DN &kp C_BRI_UP &kp PG_UP &kp F12

            &trans &mo BT &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp END &none
            >;
        };

        bt_layer {
            <
            &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &bt BT_CLR

            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &none
            >;
        };
    };
};